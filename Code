
clc;
clear;
close all;
tic;

%% ================================================================
% PAPER-BASED OTFS TRANSCEIVER
% AWGN, TF demodulation, SFFT, BER and signal visualization.
%% ================================================================

%% 1. SYSTEM PARAMETERS

N = 32;                     % Doppler bins
M = 64;                     % Delay bins

Delta_f = 20e3;              % Subcarrier spacing (Hz)
T = 1 / Delta_f;             % Useful symbol duration (seconds)

P = 4;                       % Number of channel paths
CP = 8;                      % Cyclic prefix length
maxDelay = 6;                % Maximum integer delay (samples)
maxDoppler = 3;              % Maximum integer Doppler index

QAM_order = 4;               % 4-QAM or 16-QAM
bitsPerSymbol = log2(QAM_order);

SNR_dB = [0 5 10 15 20 30];
N_frames = 20;

rng(1);

assert(QAM_order == 4 || QAM_order == 16, ...
    'QAM_order must be 4 or 16.');

assert(CP >= maxDelay, ...
    'CP must be at least maxDelay.');

Nsym = N * M;
NbitsFrame = Nsym * bitsPerSymbol;

BER = zeros(size(SNR_dB));

%% 2. BUILD GRAY-CODED QAM CONSTELLATION

labels = zeros(QAM_order, bitsPerSymbol);

for q = 0:QAM_order-1
    labels(q+1,:) = dec2bin(q,bitsPerSymbol) - '0';
end

constellation = qam_map(reshape(labels.',[],1),QAM_order);

%% 3. PLOT STORAGE

txDD = [];
rxDD = [];
txTF = [];
rxTF = [];
txTime = [];

pathGains = [];
pathDelays = [];
pathDopplers = [];

%% ================================================================
% 4. SNR LOOP
%% ================================================================

for isnr = 1:length(SNR_dB)

    fprintf('Simulating SNR = %d dB\n',SNR_dB(isnr));

    errors = 0;
    totalBits = 0;

    snrLinear = 10^(SNR_dB(isnr)/10);

    for frame = 1:N_frames

        %% 4.1 RANDOM INFORMATION BITS

        bits = randi([0 1],NbitsFrame,1);

        %% 4.2 QAM MAPPING AND DD GRID

        qamSymbols = qam_map(bits,QAM_order);

        X_DD = reshape(qamSymbols,N,M);

        %% 4.3 ISFFT: DD TO TF
        %
        % X_TF(n,m) = 1/sqrt(NM) * sum_k sum_l
        % x(k,l)*exp(j*2*pi*(n*k/N - m*l/M))
        %
        % First dimension: inverse DFT
        % Second dimension: forward DFT

        X_TF = ifft(X_DD,[],1) * sqrt(N);
        X_TF = fft(X_TF,[],2) / sqrt(M);

        %% 4.4 HEISENBERG TRANSFORM
        %
        % Rectangular pulse shaping with an M-point IFFT.

        txBlocks = ifft(X_TF,[],2) * sqrt(M);

        %% 4.5 ADD CYCLIC PREFIX

        slotLength = M + CP;
        tx = complex(zeros(N*slotLength,1));

        for n = 1:N

            block = txBlocks(n,:).';
            blockCP = [block(end-CP+1:end); block];

            idx = (n-1)*slotLength + (1:slotLength);
            tx(idx) = blockCP;

        end

        %% 4.6 TIME-VARYING MULTIPATH CHANNEL
        %
        % r[q] = sum_p h_p*s[q-delay_p]*
        % exp(j*2*pi*doppler_p*q/(N*(M+CP))) + w[q]
        %
        % Integer delays and integer Doppler indices are used.
        % The cyclic prefix covers all configured channel delays.

        delayTaps = randi([0 maxDelay],P,1);

        dopplerTaps = randi( ...
            [-maxDoppler maxDoppler],P,1);

        pdp_dB = linspace(0,-8,P).';

        pathPower = 10.^(pdp_dB/10);
        pathPower = pathPower / sum(pathPower);

        h = sqrt(pathPower/2) .* ...
            (randn(P,1) + 1i*randn(P,1));

        % Normalize the realized channel energy.
        h = h / sqrt(sum(abs(h).^2));

        rxClean = complex(zeros(size(tx)));

        sampleIndex = (0:length(tx)-1).';
        frameLength = N*(M+CP);

        for p = 1:P

            delay = delayTaps(p);
            doppler = dopplerTaps(p);

            delayedSignal = complex(zeros(size(tx)));

            if delay == 0
                delayedSignal = tx;
            else
                delayedSignal(delay+1:end) = ...
                    tx(1:end-delay);
            end

            dopplerPhase = exp( ...
                1i*2*pi*doppler*sampleIndex/frameLength);

            rxClean = rxClean + ...
                h(p)*delayedSignal.*dopplerPhase;

        end

        %% 4.7 ADD COMPLEX AWGN
        %
        % SNR is referenced to measured received signal power.

        rxPower = mean(abs(rxClean).^2);
        noiseVar = rxPower / snrLinear;

        noise = sqrt(noiseVar/2) .* ...
            (randn(size(tx)) + 1i*randn(size(tx)));

        rx = rxClean + noise;

        %% 4.8 REMOVE CYCLIC PREFIX

        rxBlocks = complex(zeros(N,M));

        for n = 1:N

            idx = (n-1)*slotLength + CP + (1:M);
            rxBlocks(n,:) = rx(idx).';

        end

        %% 4.9 TF DEMODULATION
        %
        % Matched rectangular pulse and M-point FFT.

        Y_TF = fft(rxBlocks,[],2) / sqrt(M);

        %% 4.10 SFFT: TF TO DD
        %
        % Inverse transform convention to the ISFFT above.

        Y_DD = fft(Y_TF,[],1) / sqrt(N);
        Y_DD = ifft(Y_DD,[],2) * sqrt(M);

        %% 4.11 QAM NEAREST-NEIGHBOUR DETECTION
        %
        % No channel equalizer is applied in this baseline.

        receivedSymbols = Y_DD(:);

        distances = zeros(Nsym,QAM_order);

        for q = 1:QAM_order
            distances(:,q) = ...
                abs(receivedSymbols-constellation(q)).^2;
        end

        [~,detectedIndex] = min(distances,[],2);

        detectedLabels = labels(detectedIndex,:);
        bitsHat = reshape(detectedLabels.',[],1);

        %% 4.12 BER

        errors = errors + sum(bitsHat ~= bits);
        totalBits = totalBits + NbitsFrame;

        %% SAVE THE FIRST FRAME AT THE HIGHEST SNR

        if isnr == length(SNR_dB) && frame == 1

            txDD = abs(X_DD);
            rxDD = abs(Y_DD);

            txTF = abs(X_TF);
            rxTF = abs(Y_TF);

            txTime = tx;

            pathGains = abs(h);
            pathDelays = delayTaps;
            pathDopplers = dopplerTaps;

        end

    end

    BER(isnr) = errors / totalBits;

end

%% ================================================================
% 5. CHANNEL PATH GAINS
%% ================================================================

figure;

stem(1:P,pathGains,'filled','LineWidth',1.5);

xlabel('Path Index');
ylabel('|h_p|');
title('Multipath Channel Gains');
grid on;

%% ================================================================
% 6. TRANSMITTED DD DOMAIN
%% ================================================================

figure;

surf(0:M-1,0:N-1,txDD,'EdgeColor','none');

xlabel('Delay Index');
ylabel('Doppler Index');
zlabel('|X_{DD}|');

title('Transmitted Delay-Doppler Signal');
view(45,35);
colorbar;
grid on;

%% ================================================================
% 7. TRANSMITTED TF DOMAIN
%% ================================================================

figure;

surf(0:M-1,0:N-1,txTF,'EdgeColor','none');

xlabel('Subcarrier Index');
ylabel('Time Slot');
zlabel('|X_{TF}|');

title('Transmitted Time-Frequency Signal');
view(45,35);
colorbar;
grid on;

%% ================================================================
% 8. TRANSMITTED TIME-DOMAIN WAVEFORM
%% ================================================================

figure;

numPlot = min(1000,length(txTime));

plot(0:numPlot-1,real(txTime(1:numPlot)), ...
    'LineWidth',1);

hold on;

plot(0:numPlot-1,imag(txTime(1:numPlot)), ...
    'LineWidth',1);

xlabel('Sample Index');
ylabel('Amplitude');

legend('Real Part','Imaginary Part');

title('Transmitted OTFS Time-Domain Waveform');
grid on;

%% ================================================================
% 9. RECEIVED TF AND DD DOMAINS
%% ================================================================

figure;

subplot(1,2,1);

imagesc(0:M-1,0:N-1,rxTF);

xlabel('Subcarrier Index');
ylabel('Time Slot');
title('Received TF Domain');

colorbar;
axis xy;

subplot(1,2,2);

imagesc(0:M-1,0:N-1,rxDD);

xlabel('Delay Index');
ylabel('Doppler Index');
title('Received DD Domain');

colorbar;
axis xy;

%% ================================================================
% 10. BER VS SNR
%% ================================================================

figure;

berFloor = 1/(NbitsFrame*N_frames);

semilogy(SNR_dB,max(BER,berFloor),'-o', ...
    'LineWidth',2,'MarkerSize',7);

xlabel('SNR (dB)');
ylabel('Bit Error Rate');

title('OTFS Baseline BER vs SNR');
grid on;

%% ================================================================
% 11. SIMULATION RESULTS
%% ================================================================

fprintf('\n========================================\n');
fprintf('OTFS SIMULATION COMPLETED\n');
fprintf('========================================\n');

fprintf('Doppler bins N      : %d\n',N);
fprintf('Delay bins M        : %d\n',M);
fprintf('QAM order           : %d\n',QAM_order);
fprintf('Subcarrier spacing  : %.2f kHz\n',Delta_f/1000);
fprintf('Useful symbol time  : %.2f us\n',T*1e6);
fprintf('Channel paths       : %d\n',P);
fprintf('CP length           : %d samples\n',CP);

fprintf('\nChannel delays (samples):\n');
disp(pathDelays.');

fprintf('Channel Doppler indices:\n');
disp(pathDopplers.');

fprintf('\nSNR (dB)       BER\n');

for k = 1:length(SNR_dB)
    fprintf('%5d       %.6e\n',SNR_dB(k),BER(k));
end

fprintf('\nBER is from uncoded, unequalized detection.\n');
fprintf('No fabricated OFDM comparison data is used.\n');

toc;

%% ================================================================

function symbols = qam_map(bits,Q)

    bits = double(bits(:));

    bps = log2(Q);
    axisBits = bps/2;

    bitGroups = reshape(bits,bps,[]).';

    bI = bitGroups(:,1:axisBits);
    bQ = bitGroups(:,axisBits+1:end);

    % Gray-coded bits to binary indices

    binI = zeros(size(bI));
    binQ = zeros(size(bQ));

    binI(:,1) = bI(:,1);
    binQ(:,1) = bQ(:,1);

    for k = 2:axisBits

        binI(:,k) = xor(binI(:,k-1),bI(:,k));
        binQ(:,k) = xor(binQ(:,k-1),bQ(:,k));

    end

    weights = 2.^(axisBits-1:-1:0).';

    idxI = binI*weights;
    idxQ = binQ*weights;

    L = sqrt(Q);

    levelI = (L-1)-2*idxI;
    levelQ = (L-1)-2*idxQ;

    % Normalize average QAM symbol energy to one.

    normFactor = sqrt((2/3)*(Q-1));

    symbols = (levelI+1i*levelQ)/normFactor;

end
